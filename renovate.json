{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:recommended",
    "group:allNonMajor",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigestsToSemver",
    "schedule:nonOfficeHours"
  ],
  "timezone": "Europe/Belgrade",
  "platformAutomerge": false,
  "automerge": true,
  "docker-compose": {
    "managerFilePatterns": [
      "/^docker-compose\\/[^/]+\\.ya?ml$/"
    ]
  },
  "toolSettings": {
    "nodeMaxMemory": 1024
  },
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchDatasources": [
        "npm"
      ],
      "groupName": "{{packageScope}} packages",
      "groupSlug": "{{packageScope}}-scope",
      "matchPackageNames": [
        "/^@/"
      ]
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "ci dependencies"
    }
  ]
}